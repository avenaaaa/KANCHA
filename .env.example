# Copia este archivo como .env antes del primer docker compose up
# cp .env.example .env

# ---- Base de datos ----
POSTGRES_USER=kancha
POSTGRES_PASSWORD=kancha
POSTGRES_DB=kancha
DATABASE_URL=postgresql://kancha:kancha@db:5432/kancha

# ---- Autenticación ----
# Mínimo 16 caracteres. Genera uno con: openssl rand -base64 32
JWT_SECRET=cambiar-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRES_IN=7d

# ---- Servidor ----
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000
# Saltos de proxy delante de la API: 0 en local, 1 en Render.
TRUST_PROXY=0
# Orígenes web permitidos, separados por coma. Vacío = cualquiera. En la nube: la URL del sitio web.
CORS_ORIGINS=
# Límite de intentos (S-12): contraseñas erradas por IP cada 15 min y cuentas nuevas por IP cada hora.
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=20
# DEMO_MODE=true solo lo define docker-compose.yml: recarga los datos de demostración en cada
# arranque (borra los anteriores) y acepta la clave JWT de ejemplo. No lo actives en un despliegue real.

# ---- Transbank ----
# En 'integration' el SDK usa sus propias credenciales de prueba.
# Commerce code y api key solo se completan al pasar a producción.
TBK_ENV=integration
TBK_COMMERCE_CODE=
TBK_API_KEY=
# Vacía: Transbank vuelve a la dirección por la que llegó la app (PC o celular). En la nube, la URL pública.
TBK_RETURN_URL=

# ---- Reglas de negocio ----
PLATFORM_COMMISSION_RATE=0.10
RETENTION_WINDOW_HOURS=12
RETENTION_RATE=0.50
RATING_WINDOW_HOURS=48
HONOR_SAMPLE_SIZE=20

# ---- Frontend (Expo solo expone las variables con prefijo EXPO_PUBLIC_) ----
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
