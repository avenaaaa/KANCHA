{
  "expo": {
    "name": "Kancha",
    "slug": "kancha",
    "version": "0.6.0",
    "orientation": "portrait",
    "scheme": "kancha",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1A1A1A",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1A1A1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cl.kancha.app"
    },
    "android": {
      "package": "cl.kancha.app",
      "adaptiveIcon": {
        "backgroundColor": "#1A1A1A"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "lang": "es",
      "themeColor": "#1A1A1A",
      "description": "Kancha: partidos amateur con cupo cerca de ti en La Florida. Fútbol, pádel y básquetbol."
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Kancha usa tu ubicación para mostrarte los partidos con cupos que están cerca de ti."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
