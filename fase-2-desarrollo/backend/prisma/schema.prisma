// Kancha — modelo de datos del MVP
// Documentación y diccionario completo: fase-2-desarrollo/docs/01-modelo-datos.md
// Si cambias este archivo, actualiza también ese documento y sus diagramas.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum Sport {
  FUTBOL
  PADEL
  BASQUETBOL
}

enum SkillLevel {
  PRINCIPIANTE
  MEDIO
  AVANZADO
}

enum MatchStatus {
  OPEN
  FULL
  IN_PROGRESS
  FINISHED
  ARCHIVED
  CANCELLED
}

enum PartStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
  NO_SHOW
  /// El organizador no aceptó la postulación (KAN-32). El jugador puede volver a postular.
  REJECTED
}

/// Tipos de aviso (HU-10). FALTA_UNO es el prioritario: va primero y destacado.
enum NotificationKind {
  /// Partido urgente o destacado dentro de mi radio.
  FALTA_UNO
  /// Partido nuevo que calza con mis deportes, días, horario y radio.
  NEARBY_MATCH
  /// Al organizador: alguien pide entrar a su partido.
  JOIN_REQUEST
  /// Al jugador: el organizador aprobó su postulación.
  JOIN_APPROVED
  /// Al organizador: "¿Lo destacas?" cuando le faltan 1 o 2 a 2 h o menos (KAN-41).
  PRIORITY_OFFER
  /// Ánimo para volver a jugar, por reglas y sin IA. A lo más uno por semana.
  NUDGE
}

enum PayStatus {
  INITIATED
  AUTHORIZED
  FAILED
  REFUNDED
  RETAINED
}

model User {
  id            String @id @default(uuid())
  email         String @unique
  passwordHash  String
  name          String
  favoriteSport Sport
  matchesPlayed Int    @default(0)

  /// 0.0–10.0 · NULL = "Sin calificaciones aún". Único número de reputación del producto.
  honorScore      Decimal? @db.Decimal(3, 1)
  attendanceRate  Decimal? @db.Decimal(5, 2)
  punctualityRate Decimal? @db.Decimal(5, 2)
  fairPlayRate    Decimal? @db.Decimal(5, 2)

  expoPushToken String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organizedMatches       Match[]                 @relation("organizer")
  participations         Participation[]
  ratingsGiven           Rating[]                @relation("rater")
  ratingsReceived        Rating[]                @relation("rated")
  notificationPreference NotificationPreference?
  notifications          Notification[]

  @@index([favoriteSport])
}

model Match {
  id          String @id @default(uuid())
  organizerId String
  organizer   User   @relation("organizer", fields: [organizerId], references: [id])

  title     String
  sport     Sport
  level     SkillLevel @default(MEDIO)
  venueName String
  address   String

  /// PostGIS. Prisma no tipa geometrías: se consulta con $queryRaw y ST_DWithin.
  /// El índice GIST se creó a mano (migración indice_gist_ubicacion) y se declara abajo
  /// para que `migrate dev` no lo considere sobrante y genere un DROP INDEX.
  location Unsupported("geography(Point, 4326)")

  startsAt      DateTime
  durationMin   Int         @default(60)
  totalSlots    Int
  filledSlots   Int         @default(0)
  /// CLP como entero. Nunca punto flotante para dinero. 0 = partido gratuito.
  totalCost     Int         @default(0)
  status        MatchStatus @default(OPEN)
  /// "Falta uno" destacado (KAN-41): cuándo lo destacó el organizador; null = no destacado.
  /// Destacado, cada cupo que se aprueba entra gratis y el grupo cubre esa cuota fuera de la app.
  prioritizedAt DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  participations Participation[]
  ratings        Rating[]
  notifications  Notification[]

  @@index([startsAt])
  @@index([sport, status])
  @@index([level])
  /// Búsqueda por radio con ST_DWithin (HU-04). Evidencia de C3.
  @@index([location], map: "idx_match_location", type: Gist)
}

model Participation {
  id        String     @id @default(uuid())
  matchId   String
  userId    String
  status    PartStatus @default(PENDING)
  /// ceil(totalCost / totalSlots), congelado al aprobar la participación.
  amountDue Int        @default(0)
  /// Asistencia que cierra el organizador al terminar el partido (KAN-30):
  /// null = sin cerrar · true = asistió (suma matchesPlayed) · false = no se presentó (NO_SHOW).
  attended  Boolean?
  joinedAt  DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  match   Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id])
  payment Payment?

  /// Impide postularse dos veces al mismo partido (HU-05).
  @@unique([matchId, userId])
  @@index([userId, status])
}

model Rating {
  id      String @id @default(uuid())
  matchId String
  raterId String
  ratedId String

  /// 1..5, validado con Zod en la capa de entrada y con CHECK en la migración.
  punctuality Int
  conduct     Int
  createdAt   DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  rater User  @relation("rater", fields: [raterId], references: [id])
  rated User  @relation("rated", fields: [ratedId], references: [id])

  /// Impide la doble calificación (HU-06).
  @@unique([matchId, raterId, ratedId])
  @@index([ratedId, createdAt])
}

model Payment {
  id              String @id @default(uuid())
  participationId String @unique

  amount     Int
  /// 10% de amount. Ingreso de la plataforma.
  commission Int
  /// Monto retenido por deserción dentro de la ventana de 12 h.
  retained   Int       @default(0)
  status     PayStatus @default(INITIATED)

  buyOrder     String    @unique
  sessionId    String
  token        String?
  authorizedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@index([status])
}

/// Qué avisos acepta recibir cada usuario (HU-10). Sin fila = ninguno activado.
model NotificationPreference {
  userId    String   @id
  /// "Falta uno" urgentes y destacados cerca: los avisos prioritarios.
  faltaUno  Boolean  @default(false)
  /// Partidos nuevos cerca, en mis días y horario.
  nearby    Boolean  @default(false)
  /// Ánimo para volver a jugar, a lo más uno por semana.
  nudges    Boolean  @default(false)
  sports    Sport[]
  /// Días de la semana en hora de Chile: 0 = domingo … 6 = sábado.
  days      Int[]
  /// Horario aceptado [fromHour, toHour), en hora de Chile.
  fromHour  Int      @default(18)
  toHour    Int      @default(23)
  radiusKm  Int      @default(5)
  /// Punto desde el que se mide "cerca". Sin él no hay avisos por distancia.
  lat       Float?
  lng       Float?
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Bandeja de avisos dentro de la app (HU-10). El push en Android la reutiliza (KAN-42).
model Notification {
  id        String           @id @default(uuid())
  userId    String
  kind      NotificationKind
  matchId   String?
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match? @relation(fields: [matchId], references: [id], onDelete: Cascade)

  /// Un aviso de cada tipo por usuario y partido: el barrido periódico nunca lo repite.
  @@unique([userId, kind, matchId])
  @@index([userId, createdAt])
}
