// Kancha — modelo de datos del MVP
// Documentación y diccionario completo: fase-2-desarrollo/docs/01-modelo-datos.md
// Si cambias este archivo, actualiza también ese documento y sus diagramas.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum Sport {
  FUTBOL
  PADEL
  BASQUETBOL
}

enum SkillLevel {
  PRINCIPIANTE
  MEDIO
  AVANZADO
}

enum MatchStatus {
  OPEN
  FULL
  IN_PROGRESS
  FINISHED
  ARCHIVED
  CANCELLED
}

enum PartStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
  NO_SHOW
}

enum PayStatus {
  INITIATED
  AUTHORIZED
  FAILED
  REFUNDED
  RETAINED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  name          String
  favoriteSport Sport
  matchesPlayed Int      @default(0)

  /// 0.0–10.0 · NULL = "Sin calificaciones aún". Único número de reputación del producto.
  honorScore      Decimal? @db.Decimal(3, 1)
  attendanceRate  Decimal? @db.Decimal(5, 2)
  punctualityRate Decimal? @db.Decimal(5, 2)
  fairPlayRate    Decimal? @db.Decimal(5, 2)

  expoPushToken String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organizedMatches Match[]         @relation("organizer")
  participations   Participation[]
  ratingsGiven     Rating[]        @relation("rater")
  ratingsReceived  Rating[]        @relation("rated")

  @@index([favoriteSport])
}

model Match {
  id          String @id @default(uuid())
  organizerId String
  organizer   User   @relation("organizer", fields: [organizerId], references: [id])

  title     String
  sport     Sport
  level     SkillLevel @default(MEDIO)
  venueName String
  address   String

  /// PostGIS. Prisma no tipa geometrías: se consulta con $queryRaw y ST_DWithin.
  /// El índice GIST se crea a mano en la migración.
  location Unsupported("geography(Point, 4326)")

  startsAt    DateTime
  durationMin Int         @default(60)
  totalSlots  Int
  filledSlots Int         @default(0)
  /// CLP como entero. Nunca punto flotante para dinero. 0 = partido gratuito.
  totalCost   Int         @default(0)
  status      MatchStatus @default(OPEN)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  participations Participation[]
  ratings        Rating[]

  @@index([startsAt])
  @@index([sport, status])
  @@index([level])
}

model Participation {
  id      String     @id @default(uuid())
  matchId String
  userId  String
  status  PartStatus @default(PENDING)
  /// ceil(totalCost / totalSlots), congelado al aprobar la participación.
  amountDue Int      @default(0)
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  match   Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id])
  payment Payment?

  /// Impide postularse dos veces al mismo partido (HU-05).
  @@unique([matchId, userId])
  @@index([userId, status])
}

model Rating {
  id      String @id @default(uuid())
  matchId String
  raterId String
  ratedId String

  /// 1..5, validado con Zod en la capa de entrada y con CHECK en la migración.
  punctuality Int
  conduct     Int
  createdAt   DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  rater User  @relation("rater", fields: [raterId], references: [id])
  rated User  @relation("rated", fields: [ratedId], references: [id])

  /// Impide la doble calificación (HU-06).
  @@unique([matchId, raterId, ratedId])
  @@index([ratedId, createdAt])
}

model Payment {
  id              String @id @default(uuid())
  participationId String @unique

  amount     Int
  /// 10% de amount. Ingreso de la plataforma.
  commission Int
  /// Monto retenido por deserción dentro de la ventana de 12 h.
  retained   Int       @default(0)
  status     PayStatus @default(INITIATED)

  buyOrder     String    @unique
  sessionId    String
  token        String?
  authorizedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@index([status])
}
